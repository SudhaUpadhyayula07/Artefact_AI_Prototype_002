# GEMINI_API_KEY: Required for server-side Gemini API calls.
# Never expose this key to the client bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the primary Gemini model on the server.
# Defaults to gemini-3.8-flash if not specified.
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The internal or Cloud Run service URL where this application is hosted.
APP_URL="http://localhost:3000"

# PUBLIC_SITE_URL: The canonical public domain URL for custom domain deployments.
# Falls back to APP_URL when not set.
PUBLIC_SITE_URL="https://artefact.example.com"

# CONTACT_EMAIL: Public contact email address displayed in the footer and terms page.
CONTACT_EMAIL="contact@artefact.example.com"
